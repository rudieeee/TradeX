<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.tradex.controllers.WatchlistController" styleClass="view" spacing="16">
  <Label text="Watchlist" styleClass="h1"/>
  <VBox styleClass="panel" spacing="8" VBox.vgrow="ALWAYS">
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
      <Button fx:id="removeButton" text="Remove selected" onAction="#onRemove" styleClass="ghost"/>
      <Label fx:id="message" styleClass="error"/>
    </HBox>
  </VBox>
</VBox>
